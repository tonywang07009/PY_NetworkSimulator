  "cards": [
    {
      "dot": "cyan",
      "title": "輸入與輸出",
      "items": [
        "輸入：目標、限制、既有程式與文獻；訪談保留答案、題數與未決事項。",
        "輸出：系統／change 圖、具真實 tree／絕對路徑的 trace、同一 PR 的程式與歸檔資料。"
      ]
    },
    {
      "dot": "amber",
      "title": "接受與完成",
      "items": [
        "完整文件先備妥，再逐段人工 trace；回饋修正後複驗並確認。",
        "使用者手動合併；目前 PR 未合併時，兩種模式都不開始下一個 change。"
      ]
    },
    {
      "dot": "violet",
      "title": "方法與證據",
      "items": [
        "六面向訪談、來源比較、TDD、雙軸 review 與具體架構整理，各有適用條件。",
        "P.A.R.A 原位導覽；Wiki／候選分離，明示偏好與推測分開。Jev／tag 留待設計。"
      ]
    }
  ]
